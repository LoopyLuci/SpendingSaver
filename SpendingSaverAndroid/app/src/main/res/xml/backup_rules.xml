<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <!-- The sync device token must never leave the device through backups. -->
    <exclude domain="sharedpref" path="spendingsaver_sync.xml"/>
    <!-- Only shared prefs are included, so the Transferd link identity (files/link) is never backed up. -->
</full-backup-content>
