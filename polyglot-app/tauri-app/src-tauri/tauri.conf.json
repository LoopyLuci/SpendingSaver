{
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/dist-offline/backend-service": "backend-service",
      "../../go-service/go-service.exe": "go-service/go-service.exe"
    },
    "windows": {
      "certificateThumbprint": "",
      "signCommand": "cmd /c exit 0 $1",
      "digestAlgorithm": "sha256"
    }
  },
  "productName": "SpendingSaver",
  "version": "0.1.0",
  "identifier": "com.spendingsaver.desktop",
  "plugins": {
    "updater": {
      "endpoints": ["https://spendingsaver.example.com/update/{{target}}/{{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pY3JhdGUgZm9yIGV4YW1wbGU6IDw1NDMgZGF5czE7IDw1NDMgZGF5czI7IDw1NDMgZGF5czM="
    }
  },
  "app": {
    "windows": [
      {
        "title": "SpendingSaver",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
