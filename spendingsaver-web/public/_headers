# Response headers for hosts that read a _headers file (Netlify, Cloudflare Pages). GitHub Pages ignores this file
# and cannot set custom headers: the <meta> Content-Security-Policy in index.html still applies there.
# See README.md "Deploying" for the same rules for nginx and others.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build output never changes: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry points must always be revalidated or updates would not be noticed.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/theme-init.js
  Cache-Control: no-cache
